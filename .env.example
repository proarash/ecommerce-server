# Server Configuration
ENV=dev
PORT=4000
DOMAIN=localhost
CORS_ORIGINS=http://localhost:3000

# Database
DSN=host=localhost user=postgres password=postgres dbname=ecommerce port=5432 sslmode=disable TimeZone=Asia/Tehran

# Auth / JWT
JWT_SECRET=your-super-secret-jwt-key-here

# Initial Admin Seed
ADMIN_NAME=Admin
ADMIN_MOBILE=09120000000
ADMIN_PASSWORD=your-secure-admin-password

# Telegram Notification Bot
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=

# Media Uploads
UPLOAD_DIR=uploads

# Zibal Payment Gateway
ZIBAL_MERCHANT=zibal
ZIBAL_CALLBACK_URL=http://localhost:4000/payment/callback
CLIENT_PAYMENT_REDIRECT_URL=http://localhost:3000/payment/result
